# RD Station Marketing: token público da conta
# (RD Station → Perfil da conta → Integrações → Chave de API → "token público")
RDSTATION_API_KEY=

# Identificador da conversão que aparece na RD (padrão: empreend-2026)
RDSTATION_CONVERSION_IDENTIFIER=empreend-2026

# Opcional: campo personalizado da RD para guardar o perfil ("Você é"), ex.: cf_perfil.
# Deixe vazio se o campo não existir na conta; o perfil já vai como tag.
RDSTATION_CAMPO_PERFIL=

# Endereço público do site (a Vercel preenche sozinha)
NEXT_PUBLIC_SITE_URL=
